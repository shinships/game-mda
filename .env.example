# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# --- Server-only (không có tiền tố NEXT_PUBLIC_) ---
# URL "web app" của Google Apps Script nhận lead (xem integrations/google-apps-script/README.md).
# Để trống => /api/lead chạy chế độ MOCK (chỉ log, không ghi Google Sheets).
GOOGLE_SHEETS_WEBHOOK_URL=
# Chuỗi bí mật dài, ngẫu nhiên; phải trùng với SECRET trong Script Properties của Apps Script.
WEBHOOK_SECRET=

# --- Public (lộ ra trình duyệt) ---
# Link Zalo OA cho nút "Chat tư vấn vật liệu qua Zalo", ví dụ https://zalo.me/xxxxxxxx
NEXT_PUBLIC_ZALO_OA_URL=
# Meta Pixel ID và GA4 Measurement ID (G-XXXXXXXXXX). Để trống => không nạp script.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
